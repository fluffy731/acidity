# preview (default) runs the sample workspace with fictional data and no sign-in.
# live enables owner sign-in and PostgreSQL records. Never store real records in preview.
ACIDIC_MODE=preview
DATABASE_URL=
# Direct connection for migrations when the app uses a pooled URL; may equal DATABASE_URL.
DATABASE_MIGRATION_URL=
# At least 32 random characters. Generate with: openssl rand -hex 32
AUTH_SECRET=
# Exact public origin of the app, e.g. https://acidic.lingenious.com.au (both must match).
APP_URL=
AUTH_URL=
NEXT_PUBLIC_APP_NAME=Acidic
# Business details printed on reports and used by the BAS summary. Fill in your own.
ACIDIC_LEGAL_NAME=
ACIDIC_ABN=
ACIDIC_BUSINESS_ADDRESS=3/240 Victoria Street, Richmond VIC 3121
ACIDIC_BUSINESS_EMAIL=admin@acidity.com.au
